# Supabase (pegue em: supabase.com > seu projeto > Settings > API Keys)
#
# Servidor — lidas em runtime (recomendado na Vercel)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-publishable-key
SUPABASE_SERVICE_ROLE_KEY=sua-secret-key
#
# Navegador — precisam existir no momento do build (mesmos valores acima)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-publishable-key

# Connection string do banco (botao "Connect" no topo do painel > Session pooler)
# Usada apenas para rodar migrations: npm run db:migrate
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Sessão do cliente no site /agenda (cookie assinado após informar o WhatsApp; mín. 32 caracteres)
CLIENT_SESSION_SECRET=gere-uma-chave-aleatoria-segura-de-32-chars-ou-mais

# URL pública do site (opcional). Usada na prévia do link no WhatsApp/Open Graph.
# Em produção na Vercel, se não definir, usa VERCEL_URL automaticamente.
# NEXT_PUBLIC_SITE_URL=https://agendabarbearia-seven.vercel.app
